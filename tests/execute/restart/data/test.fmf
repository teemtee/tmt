summary: Observe test restart behavior
test: ./test.sh
framework: beakerlib

restart-on-exit-code: [79]
restart-max-count: 5

/basic:
    restart-with-reboot: false

/with-reboot:
    restart-with-reboot: true

/out-of-band-reboot:
    restart-on-exit-code: [79, 255]
    restart-with-reboot: false
    environment+:
        OUT_OF_BAND_REBOOT: "yes"
