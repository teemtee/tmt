#!/bin/bash
set -eu

state_prefix="${BASH_SOURCE[0]}.state"

for argument in "$@"; do
    if [[ "$argument" == *reboot* && "$argument" != *soft-reboot* ]]; then
        touch "$state_prefix.reboot-issued"
        break
    fi
done

if [[ -f "$state_prefix.reboot-issued" && ! -f "$state_prefix.failure-injected" ]]; then
    for argument in "$@"; do
        if [[ "$argument" == *MNnT* ]]; then
            touch "$state_prefix.failure-injected"
            exit 255
        fi
    done
fi

exec /usr/bin/ssh "$@"
