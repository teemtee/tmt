/mixed:
    test: rpm -q dconf
    recommend: [dconf, forest]
    adjust:
      # CentOS 6 has no dconf; nano is available from the base vault repos
      - when: distro == centos-6
        test: rpm -q nano
        recommend: [nano, forest]

/debuginfo:
    test: rpm -q grep-debuginfo
    recommend: [grep-debuginfo, forest-debuginfo]

/weird:
    test: /bin/true
    recommend: weird-package
