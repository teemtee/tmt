provision:
    how: container
    environment:
        PROVISION_ENV: provision_value
environment:
    PLAN_ENV: plan_value

/local:
    summary: A local plan
    link: https://something.org/related
    discover:
      - name: discover-fmf
        how: fmf
      - name: discover-shell
        how: shell
        tests:
          - name: /shell-test
            test: /bin/true
    prepare:
        how: shell
        script: echo "Prepare phase"
    execute:
      - name: Execute phase
        how: tmt
    finish:
        how: shell
        script: echo "Finish phase"

/insert:
    summary: A plan with inserted steps
    discover:
      - name: discover-shell
        how: shell
        tests:
          - name: /shell-test
            test: /bin/true
    execute:
        how: tmt

/remote:
    summary: A remote plan
    discover:
        how: fmf
        url: https://github.com/teemtee/tests
        test: /tests/one
    execute:
        how: tmt

/import:
    plan:
        import:
            url: https://github.com/teemtee/tests
            name: /plans/remote
            ref: 7ab3dab

/minimal:
    summary: A minimal plan
    execute:
        how: tmt
        script: echo "Execute script"

/distgit:
    summary: A plan with distgit sources
    discover:
      - name: discover-fmf
        how: fmf
        url: https://src.fedoraproject.org/rpms/tmt.git
        ref: 518edd9
        dist-git-source: true
        dist-git-extract: tmt-1.74.0/tests/execute/basic/data
        test: ^/test/shell/good$
      - name: discover-shell
        how: shell
        url: https://src.fedoraproject.org/rpms/tmt.git
        ref: 518edd9
        dist-git-source: true
        tests:
          - name: /pyproject
            test: test -e $TMT_SOURCE_DIR/tmt-1.74.0/pyproject.toml
    execute:
        how: tmt
