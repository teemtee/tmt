prepare+:
  # Install jq and yq for cleaner tests, and required make
  - how: install
    package:
      - jq
      - yq
      - make
      - python3-pip
      - python3-pytest

# Use the internal executor
execute:
    how: tmt

environment:
  PYTEST: python3 -m pytest -vvv -ra --showlocals

# Install packages in full mode
adjust:
  - prepare+:
      - name: tmt
        how: install
        directory: tmp/RPMS/noarch
    when: how == full

    # Use the local provision method when running tests locally
  - provision:
        how: local
    when: initiator is not defined or initiator == human
    because:
        explicitly specifying the local provision method is not
        allowed in the new Testing Farm pipeline
